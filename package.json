    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "http-server": "14.1.1",
    "office-addin-dev-certs": "3.0.1",
    "office-addin-manifest": "3.0.1"
  }
}
